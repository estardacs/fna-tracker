# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
GEMINI.md

# supabase CLI local state
supabase/.temp/

# Windows NTFS alternate data streams (created when a file is downloaded)
*:Zone.Identifier

# tracker runtime log
tracker.log
launcher.log
scripts/.bin/

# colector bancario
collector/node_modules/
collector/debug/
collector/*.log
collector/.last-run.json

# Screenshots de sesiones bancarias: contienen saldos y el nombre del titular renderizados
# como píxeles, que ningún escáner de secretos detecta. Nunca versionar.
screenshots/
**/screenshots/
